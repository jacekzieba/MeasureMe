"measure.instructions.weight" = "Waż się o tej samej porze dnia, najlepiej rano. Używaj tej samej wagi na twardym, równym podłożu. Zapisz wynik po skorzystaniu z toalety i przed jedzeniem lub piciem.";
"measure.instructions.waist" = "Stań w rozluźnionej pozycji i mierz na wysokości pępka po normalnym wydechu. Taśma ma przylegać, ale nie uciskać i być równoległa do podłogi. Mierz zawsze w tym samym miejscu.";
"measure.instructions.bodyFat" = "Używaj tego samego urządzenia i podobnych warunków. Wykonuj pomiar przy podobnym poziomie nawodnienia i o stałej porze dnia. Unikaj pomiaru tuż po treningu lub dużym posiłku.";
"measure.instructions.leanBodyMass" = "Korzystaj z tego samego urządzenia i podobnych warunków. Mierz o tej samej porze i przy podobnym nawodnieniu. Śledź trendy, a nie pojedyncze odczyty.";
"measure.instructions.height" = "Mierz się boso na płaskim podłożu, plecami przy ścianie. Głowa prosto, barki rozluźnione, pięty razem. Dla spójności mierz o tej samej porze dnia.";
"measure.instructions.circumference" = "Używaj miękkiej taśmy krawieckiej na gołej skórze lub cienkiej odzieży. Taśma ma być poziomo i przylegać bez uciskania. Mierz zawsze w tych samych punktach.";
"measure.hint.shoulders" = "Mierz w najszerszym miejscu barków i mięśni naramiennych — to obwód, a nie szerokość barków.";
