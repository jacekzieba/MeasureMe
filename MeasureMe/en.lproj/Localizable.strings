/* FAQ — Premium */
"faq.premium.widgets.q" = "What are widgets?";
"faq.premium.widgets.a" = "Widgets show your latest metric value directly on the home screen or lock screen. Go to Settings → Widgets to configure which metric each widget displays.";
"faq.premium.aiinsights.q" = "How does AI Insights work?";
"faq.premium.aiinsights.a" = "AI Insights uses Apple Intelligence to analyse your recent trend and generate a short, personalised summary. It runs on device, requires a supported device with Apple Intelligence enabled, and refreshes once per day or when a new value is logged.";
"faq.premium.icloudbackup.q" = "What does iCloud backup include?";
"faq.premium.icloudbackup.a" = "iCloud backup stores all your measurements, goals, and photos in encrypted form in your personal iCloud account. It runs automatically when the app is in the background and can be restored from Settings → Data → Restore from backup.";
"faq.premium.goalprediction.q" = "How does Goal Prediction work?";
"faq.premium.goalprediction.a" = "When you set a goal, Goal Prediction uses Double Exponential Smoothing to analyse your recent trend and estimate when you will reach your target. It needs at least 7 measurements over 7 days. If your trend is moving away from the goal or is flat, a helpful message is shown instead of a date.";

